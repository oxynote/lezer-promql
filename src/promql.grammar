@top PromQL { expr }
@top MetricName { Identifier }

// MetricsQL, the VictoriaMetrics dialect, turned on with
// parser.configure({ dialect: "metricsql" }). It only adds syntax, so
// every PromQL query still parses with it on. Its tokens come from
// src/metricsql.js and exist only while the dialect is on, which keeps
// plain PromQL as strict as upstream.
@dialects { metricsql }

@precedence {
  group,
  pow @right,
  mul @left
  add @left,
  eql @left,
  and @left,
  or @left,
  ifop @left,
  defaultop @left,
  keepMetricNames @left,
  with @left
}

expr[@isGroup=Expr] {
  AggregateExpr |
  BinaryExpr |
  FunctionCall |
  MatrixSelector |
  NumberDurationLiteral |
  OffsetExpr |
  AnchoredExpr |
  SmoothedExpr |
  ParenExpr |
  StringLiteral |
  SubqueryExpr |
  UnaryExpr |
  VectorSelector |
  StepInvariantExpr |
  WithExpr |
  KeepMetricNamesExpr |
  TupleExpr
}

AnchoredExpr {
  expr Anchored
}

SmoothedExpr {
  expr Smoothed
}

AggregateExpr {
  AggregateOp AggregateModifier FunctionCallBody LimitClause? |
  AggregateOp FunctionCallBody AggregateModifier LimitClause? |
  AggregateOp FunctionCallBody LimitClause?
}

AggregateOp {
  Avg |
  Bottomk |
  Count |
  CountValues |
  Group |
  Max |
  Min |
  Quantile |
  LimitK |
  LimitRatio |
  Stddev |
  Stdvar |
  Sum |
  Topk |
  Any |
  BottomkAvg |
  BottomkLast |
  BottomkMax |
  BottomkMedian |
  BottomkMin |
  Distinct |
  Geomean |
  Histogram |
  Mad |
  Median |
  Mode |
  OutliersIQR |
  OutliersMAD |
  OutliersK |
  Quantiles |
  Share |
  Sum2 |
  TopkAvg |
  TopkLast |
  TopkMax |
  TopkMedian |
  TopkMin |
  Zscore
}

AggregateModifier {
  By GroupingLabels |
  Without GroupingLabels
}

BinaryExpr {
  expr !pow Pow    binModifiers expr |
  expr !mul Mul    binModifiers expr |
  expr !mul Div    binModifiers expr |
  expr !mul Mod    binModifiers expr |
  expr !mul Atan2  binModifiers expr |
  expr !add Add    binModifiers expr |
  expr !add Sub    binModifiers expr |
  expr !eql Eql    binModifiers expr |
  expr !eql Gte    binModifiers expr |
  expr !eql Gtr    binModifiers expr |
  expr !eql TrimUpper  binModifiers expr |
  expr !eql TrimLower  binModifiers expr |
  expr !eql Lte    binModifiers expr |
  expr !eql Lss    binModifiers expr |
  expr !eql Neq    binModifiers expr |
  expr !and And    binModifiers expr |
  expr !and Unless binModifiers expr |
  expr !or  Or     binModifiers expr |
  expr !ifop If    binModifiers expr |
  expr !ifop IfNot binModifiers expr |
  expr !defaultop Default binModifiers expr
}

MatchingModifierClause {
  (Ignoring | On) GroupingLabels
  ((GroupLeft | GroupRight) (!group (GroupingLabels | AllLabels))? PrefixClause?)?
}

FillClause {
  Fill "(" NumberDurationLiteral ")"
}

FillLeftClause {
  FillLeft "(" NumberDurationLiteral ")"
}

FillRightClause {
  FillRight "(" NumberDurationLiteral ")"
}

FillModifier {
  (FillClause | FillLeftClause | FillRightClause) |
  (FillLeftClause FillRightClause) |
  (FillRightClause FillLeftClause)
}

BoolModifier { Bool }

binModifiers {
  BoolModifier?
  MatchingModifierClause?
  FillModifier?
}

GroupingLabels {
  "(" (groupingLabel ("," groupingLabel)* ","?)? ")"
}

FunctionCall {
  FunctionIdentifier FunctionCallBody |
  CallIdentifier FunctionCallBody
}

FunctionIdentifier {
  AbsentOverTime |
  Absent |
  Abs |
  Acos |
  Acosh |
  Asin |
  Asinh |
  Atan |
  Atanh |
  AvgOverTime |
  Ceil |
  Changes |
  Clamp |
  ClampMax |
  ClampMin |
  Cos |
  Cosh |
  CountOverTime |
  DaysInMonth |
  DayOfMonth |
  DayOfWeek |
  DayOfYear |
  Deg |
  Delta |
  Deriv |
  Exp |
  FirstOverTime |
  Floor |
  HistogramCount |
  HistogramFraction |
  HistogramQuantile |
  HistogramQuantiles |
  HistogramStdDev |
  HistogramStdVar |
  HistogramSum |
  HistogramAvg |
  DoubleExponentialSmoothing |
  Hour |
  Idelta |
  Increase |
  Info |
  Integral |
  Irate |
  LabelReplace |
  LabelJoin |
  LastOverTime |
  Ln |
  Log10 |
  Log2 |
  MadOverTime |
  MaxOverTime |
  MinOverTime |
  TsOfFirstOverTime |
  TsOfMaxOverTime |
  TsOfMinOverTime |
  TsOfLastOverTime |
  Minute |
  Month |
  Pi |
  PredictLinear |
  PresentOverTime |
  QuantileOverTime |
  Rad |
  Rate |
  Resets |
  Round |
  Scalar |
  Sgn |
  Sin |
  Sinh |
  Sort |
  SortDesc |
  SortByLabel |
  SortByLabelDesc |
  StartFn |
  StartTimestamp |
  EndFn |
  Range |
  Step |
  Sqrt |
  StddevOverTime |
  StdvarOverTime |
  SumOverTime |
  Tan |
  Tanh |
  Timestamp |
  Time |
  Vector |
  Year
}

FunctionCallBody {
  "(" (expr ("," expr)* trailingComma?)? ")"
}

ParenExpr {
  "(" expr ")"
}

OffsetExpr {
  expr Offset OffsetDurationExpr
}

MatrixSelector {
  // TODO: Can this not be more specific than "expr"?
  expr "[" DurationExpr "]" |
  expr emptyRange
}

SubqueryExpr {
  expr "[" DurationExpr ":" ("" | DurationExpr) "]" |
  expr stepOnlyWindow ("" | DurationExpr) "]"
}

UnaryExpr {
  !mul UnaryOp~signed expr
}

UnaryOp {
  "-" |
  "+"
}

VectorSelector {
  (Identifier | ExtendedIdentifier | VariableReference) LabelMatchers |
  Identifier |
  ExtendedIdentifier |
  LabelMatchers
}

LabelMatchers {
  "{" (labelMatcher (("," | OrFilter) labelMatcher)* ","?)? "}"
}

labelMatcher[@inline] {
  UnquotedLabelMatcher | QuotedLabelMatcher | QuotedLabelName | TemplateReference
}

MatchOp {
  EqlSingle |
  Neq |
  EqlRegex |
  NeqRegex
}

UnquotedLabelMatcher {
    (LabelName | ExtendedLabelName | VariableReference) MatchOp stringExpr
}

QuotedLabelMatcher {
    QuotedLabelName MatchOp StringLiteral
}

QuotedLabelName {
    StringLiteral
}

StepInvariantExpr {
  expr At ( NumberDurationLiteral | AtModifierPreprocessors "(" ")" | AtExpr )
}

AtModifierPreprocessors {
  AtStart | AtEnd
}

NumberDurationLiteral  {
 ("-"|"+")?~signed (number | metricsqlNumber | inf | nan | VariableReference)
}

NumberDurationLiteralInDurationContext {
  number | metricsqlNumber | inf | nan | VariableReference | TemplateReference
}

// The MetricsQL rules. Their tokens exist only while the dialect is on, so
// plain PromQL never reaches them.

WithExpr {
  With "(" (WithBinding ("," WithBinding)* ","?)? ")" !with expr
}

WithBinding {
  (Identifier | ExtendedIdentifier) WithParams? EqlSingle expr
}

WithParams {
  "(" (withParam ("," withParam)* ","?)? ")"
}

withParam[@inline] { Identifier | ExtendedIdentifier }

KeepMetricNamesExpr {
  expr !keepMetricNames KeepMetricNames
}

LimitClause {
  Limit NumberDurationLiteral
}

PrefixClause {
  Prefix stringExpr
}

// a tuple or an empty pair of parentheses, which WITH functions take as
// arguments, as in f((a, b)).
TupleExpr {
  "(" expr tupleSeparator (expr (tupleSeparator expr)* tupleSeparator?)? ")" |
  emptyParens
}

// the time after @ may be any expression, as in @ (end() - 1h).
AtExpr {
  atParen expr ")" |
  CallIdentifier FunctionCallBody
}

// a string, or a WITH template that stands for one, joined with +.
stringExpr {
  stringPart (Concat stringPart)*
}

stringPart[@inline] { StringLiteral | TemplateReference }

groupingLabel[@inline] {
  LabelName | ExtendedLabelName | QuotedLabelName | VariableReference
}

DurationExpr {
  DurationExpr !pow Pow DurationExpr |
  DurationExpr !mul Mul DurationExpr |
  DurationExpr !mul Div DurationExpr |
  DurationExpr !mul Mod DurationExpr |
  DurationExpr !add Add DurationExpr |
  DurationExpr !add Sub DurationExpr |
  !mul UnaryOp~signed DurationExpr |
  durationPrimary
}

OffsetDurationExpr {
  !mul UnaryOp~signed OffsetDurationExpr |
  durationPrimary
}

durationPrimary[@inline] {
  DurationStep "(" ")" |
  DurationRange "(" ")" |
  DurationMinOf "(" DurationExpr "," DurationExpr ")" |
  DurationMaxOf "(" DurationExpr "," DurationExpr ")" |
  "(" DurationExpr ")" |
  NumberDurationLiteralInDurationContext
}

// MetricsQL's tokens. Declared before @tokens, so they are tried first.
@external tokens metricsqlTokens from "./metricsql" {
  metricsqlNumber,
  ExtendedIdentifier,
  ExtendedLabelName,
  TemplateReference,
  OrFilter,
  AllLabels,
  Concat,
  emptyRange,
  stepOnlyWindow,
  emptyParens,
  atParen,
  tupleSeparator,
  trailingComma
}

@skip { whitespace | LineComment }

@tokens {
  whitespace { std.whitespace+ }
  LineComment { "#" ![\n]* }

  // duration placeholders such as $__interval, $__range and
  // $__rate_interval, which the host substitutes before the query runs.
  // Accepted wherever a duration is, so an editor does not mark a valid
  // templated query as broken.
  DynamicDurationPlaceholder { "$__" $[a-zA-Z_]+ }

  // A $key that names a variable, which the host substitutes as raw text
  // before the query runs. Accepted where a value, a label name or a
  // metric name goes, never in place of a keyword or an operator.
  VariableReference { "$" $[a-z] $[a-z0-9_]* }

  number {
      (std.digit+ (("_")? std.digit)* ("." std.digit+ (("_")? std.digit)*)? | "." std.digit+ (("_")? std.digit)*) (("e" | "E") ("+" | "-")? std.digit+ (("_")? std.digit)*)? |
      "0x" (std.digit | $[a-fA-F])+ | duration | DynamicDurationPlaceholder
  }
  StringLiteral { // TODO: This is for JS, make this work for PromQL.
    '"' (![\\\n"] | "\\" _)* '"'? |
    "'" (![\\\n'] | "\\" _)* "'"? |
    "`" ![`]* "`"
  }

  duration {
    // Each line below is just the same regex repeated over and over, but each time with one of the units made non-optional,
    // to ensure that at least one <number>+<unit> pair is provided and an empty string is not recognized as a valid duration.
    ( ( std.digit+ "y" ) ( std.digit+ "w" )? ( std.digit+ "d" )? ( std.digit+ "h" )? ( std.digit+ "m" )? ( std.digit+ "s" )? ( std.digit+ "ms" )? ) |
    ( ( std.digit+ "y" )? ( std.digit+ "w" ) ( std.digit+ "d" )? ( std.digit+ "h" )? ( std.digit+ "m" )? ( std.digit+ "s" )? ( std.digit+ "ms" )? ) |
    ( ( std.digit+ "y" )? ( std.digit+ "w" )? ( std.digit+ "d" ) ( std.digit+ "h" )? ( std.digit+ "m" )? ( std.digit+ "s" )? ( std.digit+ "ms" )? ) |
    ( ( std.digit+ "y" )? ( std.digit+ "w" )? ( std.digit+ "d" )? ( std.digit+ "h" ) ( std.digit+ "m" )? ( std.digit+ "s" )? ( std.digit+ "ms" )? ) |
    ( ( std.digit+ "y" )? ( std.digit+ "w" )? ( std.digit+ "d" )? ( std.digit+ "h" )? ( std.digit+ "m" ) ( std.digit+ "s" )? ( std.digit+ "ms" )? ) |
    ( ( std.digit+ "y" )? ( std.digit+ "w" )? ( std.digit+ "d" )? ( std.digit+ "h" )? ( std.digit+ "m" )? ( std.digit+ "s" ) ( std.digit+ "ms" )? ) |
    ( ( std.digit+ "y" )? ( std.digit+ "w" )? ( std.digit+ "d" )? ( std.digit+ "h" )? ( std.digit+ "m" )? ( std.digit+ "s" )? ( std.digit+ "ms" ) )
  }
  Identifier { (std.asciiLetter | "_" | ":") (std.asciiLetter | std.digit | "_" | ":" )*}
  LabelName { (std.asciiLetter | "_") (std.asciiLetter | std.digit | "_")* }

  // Operator
  Sub { "-" }
  Add { "+" }
  Mul { "*" }
  Mod { "%" }
  Div { "/" }
  Eql { "==" }
  Neq { "!=" }
  Lte { "<=" }
  Lss { "<" }
  Gte { ">=" }
  Gtr { ">" }
  TrimUpper { "</" }
  TrimLower { ">/" }
  EqlRegex { "=~" }
  EqlSingle { "=" }
  NeqRegex { "!~" }
  Pow { "^" }

  // Special Modifier
  At { "@" }
}

// Keywords

@external specialize {Identifier} specializeIdentifier from "./tokens" {
  inf,
  nan,
  Bool,
  Ignoring,
  On,
  GroupLeft,
  GroupRight,
  Offset
}

// Contextual keywords

@external extend {Identifier} extendIdentifier from "./tokens" {
  Atan2,
  Avg,
  Bottomk,
  Count,
  CountValues,
  Group,
  Max,
  Min,
  Quantile,
  LimitK,
  LimitRatio,
  Stddev,
  Stdvar,
  Sum,
  Topk,
  By,
  Without,
  And,
  Or,
  Unless,
  StartFn,
  EndFn,
  AtStart,
  AtEnd,
  Smoothed,
  Anchored,
  Fill,
  FillLeft,
  FillRight
}

// MetricsQL's keywords, tried after the ones above.
@external extend {Identifier} extendMetricsqlIdentifier from "./metricsql" {
  Any,
  BottomkAvg,
  BottomkLast,
  BottomkMax,
  BottomkMedian,
  BottomkMin,
  Distinct,
  Geomean,
  Histogram,
  Mad,
  Median,
  Mode,
  OutliersIQR,
  OutliersMAD,
  OutliersK,
  Quantiles,
  Share,
  Sum2,
  TopkAvg,
  TopkLast,
  TopkMax,
  TopkMedian,
  TopkMin,
  Zscore,
  If,
  IfNot,
  Default,
  With,
  KeepMetricNames,
  Limit,
  Prefix,
  CallIdentifier
}

@external propSource promQLHighLight from "./highlight"
@external propSource metricsqlHighlight from "./metricsql-highlight"

  // FunctionIdentifier definitions
  Abs { condFn<"abs"> }
  Absent { condFn<"absent"> }
  AbsentOverTime { condFn<"absent_over_time"> }
  Acos { condFn<"acos"> }
  Acosh { condFn<"acosh"> }
  Asin { condFn<"asin"> }
  Asinh { condFn<"asinh">}
  Atan { condFn<"atan"> }
  Atanh { condFn<"atanh">}
  AvgOverTime { condFn<"avg_over_time"> }
  Ceil { condFn<"ceil"> }
  Changes { condFn<"changes"> }
  Clamp { condFn<"clamp"> }
  ClampMax { condFn<"clamp_max"> }
  ClampMin { condFn<"clamp_min"> }
  Cos { condFn<"cos">}
  Cosh { condFn<"cosh">}
  CountOverTime { condFn<"count_over_time"> }
  DaysInMonth { condFn<"days_in_month"> }
  DayOfMonth { condFn<"day_of_month"> }
  DayOfWeek { condFn<"day_of_week"> }
  DayOfYear { condFn<"day_of_year"> }
  Deg { condFn<"deg"> }
  Delta { condFn<"delta"> }
  Deriv { condFn<"deriv"> }
  Exp { condFn<"exp"> }
  FirstOverTime {condFn<"first_over_time">}
  Floor { condFn<"floor"> }
  HistogramAvg { condFn<"histogram_avg"> }
  HistogramCount { condFn<"histogram_count"> }
  HistogramFraction { condFn<"histogram_fraction"> }
  HistogramQuantile { condFn<"histogram_quantile"> }
  HistogramQuantiles { condFn<"histogram_quantiles"> }
  HistogramStdDev { condFn<"histogram_stddev"> }
  HistogramStdVar { condFn<"histogram_stdvar"> }
  HistogramSum { condFn<"histogram_sum"> }
  DoubleExponentialSmoothing { condFn<"double_exponential_smoothing"> }
  Hour { condFn<"hour"> }
  Idelta { condFn<"idelta"> }
  Increase { condFn<"increase"> }
  Info { condFn<"info"> }
  Integral { condFn<"integral"> }
  Irate { condFn<"irate"> }
  LabelReplace { condFn<"label_replace"> }
  LabelJoin { condFn<"label_join"> }
  LastOverTime {condFn<"last_over_time">}
  Ln { condFn<"ln"> }
  Log10 { condFn<"log10"> }
  Log2 { condFn<"log2"> }
  MadOverTime { condFn<"mad_over_time"> }
  MaxOverTime { condFn<"max_over_time"> }
  MinOverTime { condFn<"min_over_time"> }
  TsOfFirstOverTime { condFn<"ts_of_first_over_time"> }
  TsOfMaxFirstTime { condFn<"ts_of_first_over_time"> }
  TsOfMaxOverTime { condFn<"ts_of_max_over_time"> }
  TsOfMinOverTime { condFn<"ts_of_min_over_time"> }
  TsOfLastOverTime { condFn<"ts_of_last_over_time"> }
  Minute { condFn<"minute"> }
  Month { condFn<"month"> }
  Pi { condFn<"pi">}
  PredictLinear { condFn<"predict_linear"> }
  PresentOverTime { condFn<"present_over_time"> }
  QuantileOverTime { condFn<"quantile_over_time"> }
  Rad { condFn<"rad"> }
  Rate { condFn<"rate"> }
  Resets { condFn<"resets"> }
  Round { condFn<"round"> }
  Scalar { condFn<"scalar"> }
  Sgn { condFn<"sgn"> }
  Sin { condFn<"sin">}
  Sinh { condFn<"sinh"> }
  Sort { condFn<"sort"> }
  SortDesc { condFn<"sort_desc"> }
  SortByLabel { condFn<"sort_by_label"> }
  SortByLabelDesc { condFn<"sort_by_label_desc"> }
  Range { condFn<"range"> }
  StartTimestamp { condFn<"start_timestamp"> }
  Step { condFn<"step"> }
  Sqrt { condFn<"sqrt"> }
  StddevOverTime { condFn<"stddev_over_time"> }
  StdvarOverTime { condFn<"stdvar_over_time"> }
  SumOverTime { condFn<"sum_over_time"> }
  Tan { condFn<"tan"> }
  Tanh { condFn<"tanh">}
  Time { condFn<"time"> }
  Timestamp { condFn<"timestamp"> }
  Vector { condFn<"vector"> }
  Year { condFn<"year"> }

// Conditional function names (only parsed as function names when used as such).
condFn<term> { @extend<Identifier, term> }
DurationStep { condFn<"step"> }
DurationRange { condFn<"range"> }
DurationMinOf { condFn<"min_of"> }
DurationMaxOf { condFn<"max_of"> }
